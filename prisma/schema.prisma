
generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String                         @id
  name                       String
  email                      String                         @unique
  emailVerified              Boolean
  image                      String?

  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt

  // Relations
  userDetail                 UserDetail?
  sessions                   Session[]
  ownedDashboardAndHubApps   DashboardAndHub[]              @relation("DashboardAndHubAppOwner")
  testingDashboardAndHubApps DashboardAndHub[]              @relation("DashboardAndHubTesters")
  activities                 UserActivity[]
  logs                       UserLogs[]
  supportRequests            SupportRequest[]
  supportMessages            SupportMessage[]
  supportAgent               SupportAgent?
  withdrawalRequests         WithdrawalRequest[]
  wallet                     UserWallet?
  transactions               UserTransaction[]
  testerRelations            TesterRelation[]
  userPlans                  UserPlan[]
  ratings                    Rating[]
  feedbacks                  Feedback[]
  notifications              Notification[]
  websiteFeedbackSuggestions WebsiteFeedbackSuggestion[]
  auditLogs                  AuditLog[] 
  accounts                   Account[]
  passwordReset              PasswordReset[]
  orders                     Order[]
  promoUsages                UserPromoUsage[]

  @@map("user")
}

enum UserAuthType {
  EMAIL_PASSWORD
  GOOGLE
}

model UserDetail {
  id                        Int                           @id @default(autoincrement())
  userId                    String                        @unique
  first_name                String
  last_name                 String
  phone                     String?                       @unique
  auth_type                 UserAuthType

  roleId                    Int
  banned                    Boolean?                      @default(false)
  ban_reason                String?

  country                   String?
  profile_type              UserProfileType?
  job_role                  UserJobRole?

  company_name              String?
  company_size              UserCompanySize?
  position_in_company       UserCompanyPosition?
  company_website           String?

  experience_level          UserExperienceLevel?
  total_published_apps      UserTotalPublishedApps?
  platform_development      UserDevelopmentPlatform?
  publish_frequency         UserPublishFrequency?

  service_usage             UserTestingServiceReason?

  communication_methods     UserCommunicationMethod[]      @default([])
  notification_preference   UserNotificationPreference[]   @default([])

  device_company            String?
  device_model              String?
  ram                       String?
  os                        String?
  screen_resolution         String?
  language                  String?
  network                   String?

  availability              TesterAvailability?            @default(AVAILABLE)

  initial                   Boolean                        @default(true)

  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt

  role                      Role                           @relation("UserRole", fields: [roleId], references: [id])
  user                      User?                          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_detail")
}

enum UserProfileType {
  INDIVIDUAL
  COMPANY
  AGENCY
  CLIENT_MANAGER
}

enum UserJobRole {
  DEVELOPER
  QA_TESTER
  PRODUCT_MANAGER
  DESIGNER
  BUSINESS_OWNER
  MARKETING
  SALES
  PROJECT_MANAGER
  STUDENT
  HOBBYIST
  AGENCY
  OTHER
}

enum UserCompanySize {
  SIZE_1
  SIZE_2_10
  SIZE_11_50
  SIZE_51_200
  SIZE_201_500
  SIZE_501_1000
  SIZE_1001_5000
  SIZE_5001_10000
  SIZE_10000_PLUS
}

enum UserCompanyPosition {
  FOUNDER_CEO
  CTO_TECH_LEAD
  PRODUCT_MANAGER
  PROJECT_MANAGER
  SOFTWARE_ENGINEER
  QA_TESTER
  DESIGNER
  MARKETING
  SALES_BUSINESS_DEV
  OPERATIONS_ADMIN
  CUSTOMER_SUPPORT
  OTHER
}

enum UserExperienceLevel {
  INTERN
  JUNIOR
  MID
  SENIOR
  LEAD
  DIRECTOR
  OTHER
}

enum UserTotalPublishedApps {
  PUB_0
  PUB_1_5
  PUB_6_10
  PUB_11_20
  PUB_21_50
  PUB_51_PLUS
}

enum UserDevelopmentPlatform {
  NATIVE_IOS
  NATIVE_ANDROID
  FLUTTER
  REACT_NATIVE
  UNITY
  DRAG_AND_DROP
  OTHER
}

enum UserPublishFrequency {
  FIRST_APP
  OCCASIONAL
  REGULAR
  FREQUENT
  OTHER
}

enum UserTestingServiceReason {
  VERIFY_FUNCTIONALITY
  USER_FEEDBACK
  COMPLIANCE_GOOGLE_PLAY
  SAVE_TIME
  OTHER
}

enum UserCommunicationMethod {
  EMAIL
  PHONE
  WHATSAPP
  TELEGRAM
  SLACK
  OTHER
}

enum UserNotificationPreference {
  APP_SUBMITTED
  TEST_COMPLETED
  TEST_ASSIGNED
  COMMENT_ADDED
  PROMOTIONS
  OTHER
}

enum TesterAvailability {
  AVAILABLE
  BUSY
  AWAY
  DO_NOT_DISTURB
}

model TesterRelation {
  id                Int               @id @default(autoincrement())
  testerId          String
  dashboardAndHubId Int?
  isActive          Boolean           @default(true) // Deprecated in favor of status? Keep for backward compat or ease.
  status            TesterStatus      @default(IN_PROGRESS)
  joinedAt          DateTime          @default(now())
  completedAt       DateTime?
  daysCompleted     Int               @default(0)
  lastActivityAt    DateTime?
  statusDetails     Json?
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tester            User              @relation(fields: [testerId], references: [id])
  dashboardAndHub   DashboardAndHub?  @relation(fields: [dashboardAndHubId], references: [id], onDelete: Cascade)
  dailyVerifications DailyTesterVerification[]

  @@unique([testerId, dashboardAndHubId])
  @@map("tester_relation")
}

enum TesterStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DROPPED
  REMOVED
  REJECTED
}

model DailyTesterVerification {
  id                Int                @id @default(autoincrement())
  testerRelationId  Int
  dayNumber         Int                // e.g. 1, 2, 3... 14
  proofImageUrl     String
  status            VerificationStatus @default(PENDING)
  verifiedAt        DateTime?
  rejectionReason   String?
  metaData          Json?              // For anti-cheat data capture

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  testerRelation    TesterRelation     @relation(fields: [testerRelationId], references: [id], onDelete: Cascade)

  @@unique([testerRelationId, dayNumber])
  @@map("daily_tester_verification")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Session {
  id                 String   @id
  userId             String
  token              String   @unique
  expiresAt          DateTime
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Plans {
  id        String     @id @default(uuid()) @map("_id")
  name      String
  price     Float
  package   Int
  features  Json
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  userPlans UserPlan[]
  orders    Order[]

  @@map("plans")
}

model UserPlan {
  id        Int      @id @default(autoincrement())
  userId    String
  planId    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plans @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("user_plan")
}

model Blog {
  id          Int      @id @default(autoincrement())
  title       String
  authorName  String
  tags        String[]
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  media       Media[]

  @@map("blog")
}

model Faq {
  id          Int         @id @default(autoincrement())
  title       String
  description String
  category    FaqCategory
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("faq")
}

enum FaqCategory {
  general
  community
  professional
  homepage
}

model AppCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  androidApps AndroidApp[]

  @@map("app_category")
}

model DashboardAndHub {
  id                          Int                       @id @default(autoincrement())
  appId                       Int                       @unique
  appOwnerId                  String
  appType                     DashboardAndHubAppType
  currentTester               Int
  totalTester                 Int
  currentDay                  Int
  totalDay                    Int
  instructionsForTester       String?
  rewardPoints                Float?                    // Points given to the tester upon completion (decided by Admin)
  costPoints                  Float?                    // Points deducted from the owner (Free app)
  averageTimeTesting          String?
  minimumAndroidVersion       Int
  status                      DashboardAndHubStatus
  statusDetails               Json?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt

  androidApp                  AndroidApp                @relation(fields: [appId], references: [id])
  appOwner                    User                      @relation("DashboardAndHubAppOwner", fields: [appOwnerId], references: [id])
  testers                     User[]                    @relation("DashboardAndHubTesters")
  feedback                    Feedback[]
  activities                  UserActivity[]
  earningHistory              UserTransaction[]
  testerRelations             TesterRelation[]

  @@map("dashboard_and_hub")
}

enum DashboardAndHubAppType {
  PAID
  FREE
}

enum DashboardAndHubStatus {
  IN_REVIEW
  DRAFT
  REJECTED
  IN_TESTING
  COMPLETED
  ON_HOLD
  REQUESTED
  AVAILABLE
}

model AndroidApp {
  id                  Int      @id @default(autoincrement())
  appName             String   @unique
  appLogoUrl          String   @unique
  appScreenshotUrl1   String
  appScreenshotUrl2   String
  appCategoryId       Int
  packageName         String   @unique
  description         String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  appCategory         AppCategory       @relation(fields: [appCategoryId], references: [id])
  media               Media[]
  ratings             Rating[]
  activities          UserActivity[]
  dashboardAndHubs    DashboardAndHub[]

  @@map("android_app")
}

model Media {
  id                          Int                         @id @default(autoincrement())
  type                        MediaType
  mime                        String?
  category                    MediaCategory
  src                         String
  appId                       Int?
  blogId                      Int?
  feedbackId                  Int?                        @unique
  notificationId              Int?
  supportRequestId            Int?
  supportMessageId            Int?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt

  androidApp                  AndroidApp?                 @relation(fields: [appId], references: [id], onDelete: Cascade)
  blog                        Blog?                       @relation(fields: [blogId], references: [id], onDelete: Cascade)
  feedback                    Feedback?                   @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  notification                Notification?               @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  supportRequest              SupportRequest?             @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)
  supportMessage              SupportMessage?             @relation(fields: [supportMessageId], references: [id], onDelete: Cascade)
  websiteFeedbackSuggestions  WebsiteFeedbackSuggestion[]

  @@map("media")
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaCategory {
  APP_LOGO
  SCREENSHOT
  FEATURED_VIDEO
  FEATURED_IMAGE
  AUTHOR_IMAGE
  OTHER
}

model Rating {
  id         Int        @id @default(autoincrement())
  rating     Float
  ratingType RatingType
  appId      Int?
  userId     String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  androidApp AndroidApp? @relation(fields: [appId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])

  @@map("rating")
}

enum RatingType {
  APP
  USER
}

model Feedback {
  id                Int               @id @default(autoincrement())
  message           String
  type              FeedbackType
  priority          FeedbackPriority?
  testerId          String
  dashboardAndHubId Int
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tester            User              @relation(fields: [testerId], references: [id])
  dashboardAndHub   DashboardAndHub   @relation(fields: [dashboardAndHubId], references: [id], onDelete: Cascade)
  media             Media?
  userActivities    UserActivity[]

  @@map("feedback")
}

enum FeedbackType {
  BUG
  SUGGESTION
  PRAISE
  OTHER
}

enum FeedbackPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

model Notification {
  id            Int               @id @default(autoincrement())
  title         String
  description   String
  type          NotificationType  @default(OTHER)
  url           String?
  userId        String?
  isActive      Boolean

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user          User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  media         Media[]

  @@map("notification")
}

enum NotificationType {
  NEW_TEST
  FEEDBACK_RECEIVED
  TEST_COMPLETED
  BUG_REPORT
  POINTS_AWARDED
  NEW_JOIN_REQUEST
  NEW_JOIN_ACCEPT
  REJECTED
  OTHER
}

model UserActivity {
  id                Int            @id @default(autoincrement())
  userId            String
  dashboardAndHubId Int?
  androidAppId      Int?
  feedbackId        Int?
  actionType        UserActionType
  description       String?
  context           Json?
  ipAddress         String?
  userAgent         String?
  status            AuditResult
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  dashboardAndHub DashboardAndHub? @relation(fields: [dashboardAndHubId], references: [id])
  androidApp      AndroidApp?      @relation(fields: [androidAppId], references: [id])
  feedback        Feedback?        @relation(fields: [feedbackId], references: [id])

  @@map("user_activity")
}

enum UserActionType {
  DRAFT
  SUBMIT_APP
  JOIN_TEST_REQUEST
  JOIN_TEST_ACCEPT
  JOIN_TEST_REJECTED
  COMPLETE_TEST
  GIVE_FEEDBACK
  RATE_APP
  LOGIN
  LOGOUT
  UPDATE_PROFILE
  REGISTER
  RENEW_TOKENS
  OTHER
}

model UserLogs {
  id          Int                 @id @default(autoincrement())
  userId      String
  logType     LogType
  severity    LogSeverity?
  description String
  context     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime            @default(now())

  user        User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_logs")
}

enum LogType {
  LOGIN
  REGISTER
  LOGOUT
  PASSWORD_RESET
  RENEW_TOKENS
  ERROR
  ADMIN_ACTION
  SYSTEM_ACTION
  OTHER
}

enum LogSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

model WebsiteFeedbackSuggestion {
  id        Int                    @id @default(autoincrement())
  userId    String
  type      FeedbackSuggestionType
  title     String?
  message   String
  priority  FeedbackPriority?
  status    FeedbackStatus         @default(PENDING)
  reason    String?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  user  User    @relation(fields: [userId], references: [id])
  media Media[]

  @@map("website_feedback_suggestion")
}

enum FeedbackSuggestionType {
  BUG
  SUGGESTIONS
  PRAISE
  OTHER
}

enum FeedbackStatus {
  PENDING
  REVIEWED
  IMPLEMENTED
  REJECTED
}

model SupportRequest {
  id             Int             @id @default(autoincrement())
  userId         String?
  supportAgentId Int?
  name           String?
  email          String?
  subject        String
  description    String
  status         SupportStatus   @default(PENDING)
  category       SupportCategory @default(GENERAL)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user         User?            @relation(fields: [userId], references: [id])
  messages     SupportMessage[]
  media        Media[]
  supportAgent SupportAgent?    @relation(fields: [supportAgentId], references: [id])

  @@map("support_request")
}

enum SupportStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportCategory {
  GENERAL
  TECHNICAL
  BILLING
  ACCOUNT
  OTHER
}

model SupportMessage {
  id               Int        @id @default(autoincrement())
  supportRequestId Int
  senderId         String?
  senderType       SenderType
  message          String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  supportRequest SupportRequest @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)
  senderUser     User?          @relation(fields: [senderId], references: [id])
  media          Media[]

  @@map("support_message")
}

enum SenderType {
  USER
  AGENT
}

model SupportAgent {
  id               Int              @id @default(autoincrement())
  userId           String           @unique
  assignedRequests SupportRequest[]

  user User @relation(fields: [userId], references: [id])

  @@map("support_agent")
}

model WithdrawalRequest {
  id          Int              @id @default(autoincrement())
  userId      String
  amount      Float
  currency    String           @default("USD")
  status      WithdrawalStatus @default(PENDING)
  requestedAt DateTime         @default(now())
  processedAt DateTime?
  note        String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("withdrawal_request")
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model UserTransaction {
  id                  Int                      @id @default(autoincrement())
  userId              String
  userWalletId        Int?
  dashboardAndHubId   Int?                     // optional if some transactions aren't dashboard-related
  action              EarningAction?           // keep optional for non-earning transactions
  points              Float?                   @default(0)
  package             Float?                   @default(0)
  transactionType     UserTransactionType      // NEW: type of transaction
  status              UserTransactionStatus
  createdAt           DateTime                 @default(now())

  user                User                     @relation(fields: [userId], references: [id])
  dashboardAndHub     DashboardAndHub?         @relation(fields: [dashboardAndHubId], references: [id])
  userWallet          UserWallet?              @relation(fields: [userWalletId], references: [id])

  @@map("user_transactions")
}

enum UserTransactionType {
  EARNING
  WITHDRAWAL
  PURCHASE
  REFUND
  BONUS
  OTHER
}

enum EarningAction {
  TESTING
  FEEDBACK
  REFERRAL
  BONUS
  APP_SUBMISSION
  OTHER
}

enum UserTransactionStatus {
  CREDIT
  DEBIT
  HOLD
}

model UserWallet {
  id                Int                     @id @default(autoincrement())
  userId            String                  @unique
  totalPoints       Float                   @default(0)
  totalPackages     Float                   @default(0)
  lastUpdated       DateTime                @updatedAt
  createdAt         DateTime                @default(now())

  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  earningHistory    UserTransaction[]

  @@map("user_wallet")
}

model Role {
  id                Int    @id @default(autoincrement())
  name              String @unique

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  permissions       Permission[]
  usersDetail       UserDetail[]       @relation("UserRole")

  @@map("role")
}

model Module {
  id   Int    @id @default(autoincrement())
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions Permission[]

  @@map("module")
}

model Permission {
  id            Int     @id @default(autoincrement())
  roleId        Int
  moduleId      Int
  canReadList   Boolean @default(false)
  canReadSingle Boolean @default(false)
  canCreate     Boolean @default(false)
  canUpdate     Boolean @default(false)
  canDelete     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("permission")
}

model AuditLog {
  id         Int          @id @default(autoincrement())
  actorId    String
  actorRole  String
  module     String
  action     String
  targetId   String
  result     AuditResult
  reason     String?
  ip         String
  ua         String
  ts         DateTime     @default(now())

  actor      User    @relation(fields: [actorId], references: [id])

  @@map("audit_log")
}

enum AuditResult {
  SUCCESS
  FAIL
}

model Account {
  id                        String            @id
  userId                    String
  accountId                 String
  providerId                String
  accessToken               String?
  refreshToken              String?
  accessTokenExpiresAt      DateTime?
  refreshTokenExpiresAt     DateTime?
  scope                     String?
  idToken                   String?
  password                  String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  user                      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id              String           @id
  identifier      String
  value           String
  expiresAt       DateTime
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt

  @@map("verification")
}

model PasswordReset {
  id                      Int                   @id @default(autoincrement())
  password_reset_token    String                @unique
  userId                  String
  expireAt                DateTime
  isActive                Boolean               @default(true)

  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @default(now()) @updatedAt

  user                    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset")
}

model ControlRoom {
  id                          Int                   @id @default(autoincrement())
  profileSurveyPoints         Int?
  pointsWithdrawalLimit       Int?
  pointsWithdrawalThreshold   Int?

  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @default(now()) @updatedAt

  @@map("control_room")
}

// ==================== RAZORPAY PAYMENT MODELS ====================

model Order {
  id                  Int                 @id @default(autoincrement())
  userId              String
  planId              String?
  packageCount        Int?                @default(1)
  
  // Razorpay specific fields
  razorpayOrderId     String              @unique
  receipt             String              @unique
  
  // Amount in smallest currency unit (paise for INR)
  amount              Int
  currency            String              @default("INR")
  
  status              OrderStatus         @default(CREATED)
  
  // Metadata for tracking
  notes               Json?
  attempts            Int                 @default(0)
  
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  expiresAt           DateTime?

  // Relations
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                Plans?              @relation(fields: [planId], references: [id])
  payments            Payment[]

  @@index([userId])
  @@index([razorpayOrderId])
  @@index([status])
  @@map("order")
}

enum OrderStatus {
  CREATED
  ATTEMPTED
  PAID
  EXPIRED
  CANCELLED
}

model Payment {
  id                    Int                 @id @default(autoincrement())
  orderId               Int
  
  // Razorpay specific fields
  razorpayPaymentId     String              @unique
  razorpayOrderId       String
  razorpaySignature     String?
  
  // Amount in smallest currency unit (paise for INR)
  amount                Int
  currency              String              @default("INR")
  
  // Payment details
  status                PaymentStatus       @default(PENDING)
  method                String?             // card, netbanking, upi, wallet, etc.
  bank                  String?
  wallet                String?
  vpa                   String?             // UPI VPA
  
  // Customer details from Razorpay
  email                 String?
  contact               String?
  
  // Transaction fees
  fee                   Int?                @default(0)
  tax                   Int?                @default(0)
  
  // Error tracking
  errorCode             String?
  errorDescription      String?
  errorReason           String?
  
  // Refund tracking
  amountRefunded        Int                 @default(0)
  refundStatus          RefundStatus?
  
  // Metadata
  notes                 Json?
  captured              Boolean             @default(false)
  international         Boolean             @default(false)
  
  // Webhook tracking
  webhookVerified       Boolean             @default(false)
  webhookPayload        Json?
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  order                 Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds               Refund[]

  @@index([orderId])
  @@index([razorpayPaymentId])
  @@index([razorpayOrderId])
  @@index([status])
  @@map("payment")
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Refund {
  id                  Int                 @id @default(autoincrement())
  paymentId           Int
  
  // Razorpay specific fields
  razorpayRefundId    String              @unique
  razorpayPaymentId   String
  
  // Amount in smallest currency unit
  amount              Int
  currency            String              @default("INR")
  
  status              RefundModelStatus   @default(PENDING)
  reason              String?
  notes               Json?
  
  // Speed of refund
  speed               String?             @default("normal") // normal or optimum
  
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  processedAt         DateTime?

  // Relations
  payment             Payment             @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([razorpayRefundId])
  @@map("refund")
}

enum RefundStatus {
  NONE
  PARTIAL
  FULL
}

enum RefundModelStatus {
  PENDING
  PROCESSED
  FAILED
}

// Webhook event log for idempotency and debugging
model WebhookEventLog {
  id                  Int                 @id @default(autoincrement())
  eventId             String              @unique  // Razorpay event ID for idempotency
  eventType           String
  payload             Json
  processed           Boolean             @default(false)
  processingError     String?
  
  createdAt           DateTime            @default(now())
  processedAt         DateTime?

  @@index([eventId])
  @@index([eventType])
  @@map("webhook_event_log")
}

model PromoCode {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  fixedPoints Float    @default(200) // The cost when this code is used
  isActive    Boolean  @default(true)
  maxUses     Int?     // Total global limits across all users
  maxPerUser  Int?     // Max times a single user can use this code
  usedCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  usages      UserPromoUsage[]

  @@map("promo_code")
}

model UserPromoUsage {
  id          Int      @id @default(autoincrement())
  userId      String
  promoCodeId Int
  usedCount   Int      @default(0)
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@unique([userId, promoCodeId])
  @@map("user_promo_usage")
}
