generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
}

model User {
  id                         String                      @id
  name                       String
  email                      String                      @unique
  emailVerified              Boolean
  image                      String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  accounts                   Account[]
  auditLogs                  AuditLog[]
  ownedDashboardAndHubApps   DashboardAndHub[]           @relation("DashboardAndHubAppOwner")
  feedbacks                  Feedback[]
  notifications              Notification[]
  orders                     Order[]
  passwordReset              PasswordReset[]
  ratings                    Rating[]
  sessions                   Session[]
  supportAgent               SupportAgent?
  supportMessages            SupportMessage[]
  supportRequests            SupportRequest[]
  testerRelations            TesterRelation[]
  activities                 UserActivity[]
  userDetail                 UserDetail?
  logs                       UserLogs[]
  userPlans                  UserPlan[]
  promoUsages                UserPromoUsage[]
  transactions               UserTransaction[]
  wallet                     UserWallet?
  websiteFeedbackSuggestions WebsiteFeedbackSuggestion[]
  withdrawalRequests         WithdrawalRequest[]
  testingDashboardAndHubApps DashboardAndHub[]           @relation("DashboardAndHubTesters")

  @@map("user")
}

model UserDetail {
  id                      Int                          @id @default(autoincrement())
  userId                  String                       @unique
  first_name              String
  last_name               String
  phone                   String?                      @unique
  auth_type               UserAuthType
  roleId                  Int
  banned                  Boolean?                     @default(false)
  ban_reason              String?
  country                 String?
  profile_type            UserProfileType?
  job_role                UserJobRole?
  company_name            String?
  company_size            UserCompanySize?
  position_in_company     UserCompanyPosition?
  company_website         String?
  experience_level        UserExperienceLevel?
  total_published_apps    UserTotalPublishedApps?
  platform_development    UserDevelopmentPlatform?
  publish_frequency       UserPublishFrequency?
  service_usage           UserTestingServiceReason?
  communication_methods   UserCommunicationMethod[]    @default([])
  notification_preference UserNotificationPreference[] @default([])
  device_company          String?
  device_model            String?
  ram                     String?
  os                      String?
  screen_resolution       String?
  language                String?
  network                 String?
  bio                     String?
  years_of_experience     String?
  testing_types           String[]                    @default([])
  tester_devices          String[]                    @default([])
  tester_os_versions      String[]                    @default([])
  initial                 Boolean                      @default(true)
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  availability            TesterAvailability?          @default(AVAILABLE)
  role                    Role                         @relation("UserRole", fields: [roleId], references: [id])
  user                    User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_detail")
}

model TesterRelation {
  id                 Int                       @id @default(autoincrement())
  testerId           String
  dashboardAndHubId  Int?
  isActive           Boolean                   @default(true)
  status             TesterStatus              @default(IN_PROGRESS)
  joinedAt           DateTime                  @default(now())
  completedAt        DateTime?
  daysCompleted      Int                       @default(0)
  lastActivityAt     DateTime?
  statusDetails      Json?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  dailyVerifications DailyTesterVerification[]
  dashboardAndHub    DashboardAndHub?          @relation(fields: [dashboardAndHubId], references: [id], onDelete: Cascade)
  tester             User                      @relation(fields: [testerId], references: [id])

  @@unique([testerId, dashboardAndHubId])
  @@map("tester_relation")
}

model DailyTesterVerification {
  id               Int                @id @default(autoincrement())
  testerRelationId Int
  dayNumber        Int
  proofImageUrl    String
  status           VerificationStatus @default(PENDING)
  verifiedAt       DateTime?
  rejectionReason  String?
  metaData         Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  testerRelation   TesterRelation     @relation(fields: [testerRelationId], references: [id], onDelete: Cascade)

  @@unique([testerRelationId, dayNumber])
  @@map("daily_tester_verification")
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Plans {
  id        String     @id @default(uuid()) @map("_id")
  name      String
  price     Float
  package   Int
  features  Json
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  orders    Order[]
  userPlans UserPlan[]

  @@map("plans")
}

model UserPlan {
  id        Int      @id @default(autoincrement())
  userId    String
  planId    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  plan      Plans    @relation(fields: [planId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_plan")
}

model Blog {
  id               Int       @id @default(autoincrement())
  title            String
  slug             String    @unique
  excerpt          String
  content          String
  authorName       String
  authorAvatarUrl  String?
  authorDataAiHint String?
  imageUrl         String
  dataAiHint       String?
  tags             String[]
  isActive         Boolean   @default(true)
  date             DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  media            Media[]

  @@map("blog")
}

model Faq {
  id          Int         @id @default(autoincrement())
  title       String
  description String
  category    FaqCategory
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("faq")
}

model AppCategory {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  androidApps AndroidApp[]

  @@map("app_category")
}

model DashboardAndHub {
  id                    Int                    @id @default(autoincrement())
  appId                 Int                    @unique
  appOwnerId            String
  appType               DashboardAndHubAppType
  currentTester         Int
  totalTester           Int
  currentDay            Int
  totalDay              Int
  testingStartDate      DateTime?
  testingEndDate        DateTime?
  instructionsForTester String?
  rewardPoints          Float?
  costPoints            Float?
  rewardMoney           Float?
  costMoney             Float?
  averageTimeTesting    String?
  minimumAndroidVersion Float
  status                DashboardAndHubStatus
  statusDetails         Json?
  promoCodeId           Int?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  androidApp            AndroidApp             @relation(fields: [appId], references: [id])
  appOwner              User                   @relation("DashboardAndHubAppOwner", fields: [appOwnerId], references: [id])
  feedback              Feedback[]
  testerRelations       TesterRelation[]
  activities            UserActivity[]
  earningHistory        UserTransaction[]
  testers               User[]                 @relation("DashboardAndHubTesters")
  promoCode             PromoCode?             @relation(fields: [promoCodeId], references: [id])

  @@map("dashboard_and_hub")
}

model AndroidApp {
  id                Int              @id @default(autoincrement())
  appName           String           @unique
  appLogoUrl        String           @unique
  appScreenshotUrl1 String
  appScreenshotUrl2 String
  appCategoryId     Int
  packageName       String           @unique
  description       String?
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  appCategory       AppCategory      @relation(fields: [appCategoryId], references: [id])
  dashboardAndHubs  DashboardAndHub?
  media             Media[]
  ratings           Rating[]
  activities        UserActivity[]

  @@map("android_app")
}

model Media {
  id                         Int                         @id @default(autoincrement())
  type                       MediaType
  mime                       String?
  category                   MediaCategory
  src                        String
  appId                      Int?
  blogId                     Int?
  feedbackId                 Int?                        @unique
  notificationId             Int?
  supportRequestId           Int?
  supportMessageId           Int?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  androidApp                 AndroidApp?                 @relation(fields: [appId], references: [id], onDelete: Cascade)
  blog                       Blog?                       @relation(fields: [blogId], references: [id], onDelete: Cascade)
  feedback                   Feedback?                   @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  notification               Notification?               @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  supportMessage             SupportMessage?             @relation(fields: [supportMessageId], references: [id], onDelete: Cascade)
  supportRequest             SupportRequest?             @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)
  websiteFeedbackSuggestions WebsiteFeedbackSuggestion[] @relation("MediaToWebsiteFeedbackSuggestion")

  @@map("media")
}

model Rating {
  id         Int         @id @default(autoincrement())
  rating     Float
  ratingType RatingType
  appId      Int?
  userId     String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  androidApp AndroidApp? @relation(fields: [appId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])

  @@map("rating")
}

model Feedback {
  id                Int               @id @default(autoincrement())
  message           String
  type              FeedbackType
  priority          FeedbackPriority?
  testerId          String
  dashboardAndHubId Int
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  dashboardAndHub   DashboardAndHub   @relation(fields: [dashboardAndHubId], references: [id], onDelete: Cascade)
  tester            User              @relation(fields: [testerId], references: [id])
  media             Media?
  userActivities    UserActivity[]

  @@map("feedback")
}

model Notification {
  id          Int              @id @default(autoincrement())
  title       String
  description String
  type        NotificationType @default(OTHER)
  url         String?
  userId      String?
  isActive    Boolean
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  media       Media[]
  user        User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification")
}

model UserActivity {
  id                Int              @id @default(autoincrement())
  userId            String
  dashboardAndHubId Int?
  androidAppId      Int?
  actionType        UserActionType
  description       String?
  context           Json?
  ipAddress         String?
  userAgent         String?
  status            AuditResult
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  feedbackId        Int?
  androidApp        AndroidApp?      @relation(fields: [androidAppId], references: [id])
  dashboardAndHub   DashboardAndHub? @relation(fields: [dashboardAndHubId], references: [id])
  feedback          Feedback?        @relation(fields: [feedbackId], references: [id])
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_activity")
}

model UserLogs {
  id          Int          @id @default(autoincrement())
  userId      String
  logType     LogType
  severity    LogSeverity?
  description String
  context     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_logs")
}

model WebsiteFeedbackSuggestion {
  id        Int                    @id @default(autoincrement())
  userId    String
  type      FeedbackSuggestionType
  title     String?
  message   String
  priority  FeedbackPriority?
  status    FeedbackStatus         @default(PENDING)
  reason    String?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  user      User                   @relation(fields: [userId], references: [id])
  media     Media[]                @relation("MediaToWebsiteFeedbackSuggestion")

  @@map("website_feedback_suggestion")
}

model SupportRequest {
  id             Int              @id @default(autoincrement())
  userId         String?
  supportAgentId Int?
  name           String?
  email          String?
  subject        String
  description    String
  status         SupportStatus    @default(PENDING)
  category       SupportCategory  @default(GENERAL)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  media          Media[]
  messages       SupportMessage[]
  supportAgent   SupportAgent?    @relation(fields: [supportAgentId], references: [id])
  user           User?            @relation(fields: [userId], references: [id])

  @@map("support_request")
}

model SupportMessage {
  id               Int            @id @default(autoincrement())
  supportRequestId Int
  senderId         String?
  senderType       SenderType
  message          String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  media            Media[]
  senderUser       User?          @relation(fields: [senderId], references: [id])
  supportRequest   SupportRequest @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)

  @@map("support_message")
}

model SupportAgent {
  id               Int              @id @default(autoincrement())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id])
  assignedRequests SupportRequest[]

  @@map("support_agent")
}

model WithdrawalRequest {
  id          Int              @id @default(autoincrement())
  userId      String
  amount      Float
  currency    String           @default("USD")
  status      WithdrawalStatus @default(PENDING)
  requestedAt DateTime         @default(now())
  processedAt DateTime?
  note        String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id])

  @@map("withdrawal_request")
}

model UserTransaction {
  id                Int                   @id @default(autoincrement())
  userId            String
  userWalletId      Int?
  dashboardAndHubId Int?
  action            EarningAction?
  points            Float?                @default(0)
  package           Float?                @default(0)
  transactionType   UserTransactionType
  status            UserTransactionStatus
  createdAt         DateTime              @default(now())
  dashboardAndHub   DashboardAndHub?      @relation(fields: [dashboardAndHubId], references: [id])
  user              User                  @relation(fields: [userId], references: [id])
  userWallet        UserWallet?           @relation(fields: [userWalletId], references: [id])

  @@map("user_transactions")
}

model UserWallet {
  id             Int               @id @default(autoincrement())
  userId         String            @unique
  totalPoints    Float             @default(0)
  totalPackages  Float             @default(0)
  balanceMoney   Float             @default(0)
  lastUpdated    DateTime          @updatedAt
  createdAt      DateTime          @default(now())
  earningHistory UserTransaction[]
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_wallet")
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[]
  usersDetail UserDetail[] @relation("UserRole")

  @@map("role")
}

model Module {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[]

  @@map("module")
}

model Permission {
  id            Int      @id @default(autoincrement())
  roleId        Int
  moduleId      Int
  canReadList   Boolean  @default(false)
  canReadSingle Boolean  @default(false)
  canCreate     Boolean  @default(false)
  canUpdate     Boolean  @default(false)
  canDelete     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  module        Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  role          Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@map("permission")
}

model AuditLog {
  id        Int         @id @default(autoincrement())
  actorId   String
  actorRole String
  module    String
  action    String
  targetId  String
  result    AuditResult
  reason    String?
  ip        String
  ua        String
  ts        DateTime    @default(now())
  actor     User        @relation(fields: [actorId], references: [id])

  @@map("audit_log")
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model PasswordReset {
  id                   Int      @id @default(autoincrement())
  password_reset_token String   @unique
  userId               String
  expireAt             DateTime
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset")
}

model ControlRoom {
  id                        Int      @id @default(autoincrement())
  profileSurveyPoints       Int?
  pointsWithdrawalLimit     Int?
  pointsWithdrawalThreshold Int?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @default(now()) @updatedAt

  @@map("control_room")
}

model Order {
  id              Int         @id @default(autoincrement())
  userId          String
  planId          String?
  packageCount    Int?        @default(1)
  razorpayOrderId String      @unique
  receipt         String      @unique
  amount          Int
  currency        String      @default("INR")
  status          OrderStatus @default(CREATED)
  notes           Json?
  attempts        Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  expiresAt       DateTime?
  plan            Plans?      @relation(fields: [planId], references: [id])
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments        Payment[]

  @@index([userId])
  @@index([razorpayOrderId])
  @@index([status])
  @@map("order")
}

model Payment {
  id                Int           @id @default(autoincrement())
  orderId           Int
  razorpayPaymentId String        @unique
  razorpayOrderId   String
  razorpaySignature String?
  amount            Int
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  method            String?
  bank              String?
  wallet            String?
  vpa               String?
  email             String?
  contact           String?
  fee               Int?          @default(0)
  tax               Int?          @default(0)
  errorCode         String?
  errorDescription  String?
  errorReason       String?
  amountRefunded    Int           @default(0)
  refundStatus      RefundStatus?
  notes             Json?
  captured          Boolean       @default(false)
  international     Boolean       @default(false)
  webhookVerified   Boolean       @default(false)
  webhookPayload    Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds           Refund[]

  @@index([orderId])
  @@index([razorpayPaymentId])
  @@index([razorpayOrderId])
  @@index([status])
  @@map("payment")
}

model Refund {
  id                Int               @id @default(autoincrement())
  paymentId         Int
  razorpayRefundId  String            @unique
  razorpayPaymentId String
  amount            Int
  currency          String            @default("INR")
  status            RefundModelStatus @default(PENDING)
  reason            String?
  notes             Json?
  speed             String?           @default("normal")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  processedAt       DateTime?
  payment           Payment           @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([razorpayRefundId])
  @@map("refund")
}

model WebhookEventLog {
  id              Int       @id @default(autoincrement())
  eventId         String    @unique
  eventType       String
  payload         Json
  processed       Boolean   @default(false)
  processingError String?
  createdAt       DateTime  @default(now())
  processedAt     DateTime?

  @@index([eventId])
  @@index([eventType])
  @@map("webhook_event_log")
}

model PromoCode {
  id                   Int               @id @default(autoincrement())
  code                 String            @unique
  discountType         String            @default("FIXED") // "FIXED" | "PERCENTAGE"
  discountValue        Float             @default(0)
  isActive             Boolean          @default(true)
  maxUses              Int?
  maxPerUser           Int?
  usedCount            Int              @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  usages               UserPromoUsage[]
  dashboardAndHubs      DashboardAndHub[]

  @@map("promo_code")
}

model UserPromoUsage {
  id          Int       @id @default(autoincrement())
  userId      String
  promoCodeId Int
  usedCount   Int       @default(0)
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, promoCodeId])
  @@map("user_promo_usage")
}

enum UserAuthType {
  EMAIL_PASSWORD
  GOOGLE
}

enum UserProfileType {
  INDIVIDUAL
  COMPANY
  AGENCY
  CLIENT_MANAGER
}

enum UserJobRole {
  DEVELOPER
  QA_TESTER
  PRODUCT_MANAGER
  DESIGNER
  BUSINESS_OWNER
  MARKETING
  SALES
  PROJECT_MANAGER
  STUDENT
  HOBBYIST
  AGENCY
  OTHER
}

enum UserCompanySize {
  SIZE_1
  SIZE_2_10
  SIZE_11_50
  SIZE_51_200
  SIZE_201_500
  SIZE_501_1000
  SIZE_1001_5000
  SIZE_5001_10000
  SIZE_10000_PLUS
}

enum UserCompanyPosition {
  FOUNDER_CEO
  CTO_TECH_LEAD
  PRODUCT_MANAGER
  PROJECT_MANAGER
  SOFTWARE_ENGINEER
  QA_TESTER
  DESIGNER
  MARKETING
  SALES_BUSINESS_DEV
  OPERATIONS_ADMIN
  CUSTOMER_SUPPORT
  OTHER
}

enum UserExperienceLevel {
  INTERN
  JUNIOR
  MID
  SENIOR
  LEAD
  DIRECTOR
  OTHER
}

enum UserTotalPublishedApps {
  PUB_0
  PUB_1_5
  PUB_6_10
  PUB_11_20
  PUB_21_50
  PUB_51_PLUS
}

enum UserDevelopmentPlatform {
  NATIVE_IOS
  NATIVE_ANDROID
  FLUTTER
  REACT_NATIVE
  UNITY
  DRAG_AND_DROP
  OTHER
}

enum UserPublishFrequency {
  FIRST_APP
  OCCASIONAL
  REGULAR
  FREQUENT
  OTHER
}

enum UserTestingServiceReason {
  VERIFY_FUNCTIONALITY
  USER_FEEDBACK
  COMPLIANCE_GOOGLE_PLAY
  SAVE_TIME
  OTHER
}

enum UserCommunicationMethod {
  EMAIL
  PHONE
  WHATSAPP
  TELEGRAM
  SLACK
  OTHER
}

enum UserNotificationPreference {
  APP_SUBMITTED
  TEST_COMPLETED
  TEST_ASSIGNED
  COMMENT_ADDED
  PROMOTIONS
  OTHER
}

enum TesterAvailability {
  AVAILABLE
  BUSY
  AWAY
  DO_NOT_DISTURB
}

enum TesterStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DROPPED
  REMOVED
  REJECTED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum FaqCategory {
  general
  community
  professional
  homepage
}

enum DashboardAndHubAppType {
  PAID
  FREE
}

enum DashboardAndHubStatus {
  IN_REVIEW
  DRAFT
  REJECTED
  IN_TESTING
  COMPLETED
  ON_HOLD
  REQUESTED
  AVAILABLE
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaCategory {
  APP_LOGO
  SCREENSHOT
  FEATURED_VIDEO
  FEATURED_IMAGE
  AUTHOR_IMAGE
  OTHER
}

enum RatingType {
  APP
  USER
}

enum FeedbackType {
  BUG
  SUGGESTION
  PRAISE
  OTHER
}

enum FeedbackPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum NotificationType {
  NEW_TEST
  FEEDBACK_RECEIVED
  TEST_COMPLETED
  BUG_REPORT
  POINTS_AWARDED
