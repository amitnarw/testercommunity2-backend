generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String                      @id
  name                       String
  email                      String                      @unique
  emailVerified              Boolean
  image                      String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  accounts                   Account[]
  auditLogs                  AuditLog[]
  ownedDashboardAndHubApps   DashboardAndHub[]           @relation("DashboardAndHubAppOwner")
  feedbacks                  Feedback[]
  notifications              Notification[]
  orders                     Order[]
  passwordReset              PasswordReset[]
  ratings                    Rating[]
  reviews                    Review[]
  sessions                   Session[]
  conversations              Conversation[]              @relation("UserConversations")
  assignedConversations      Conversation[]              @relation("AssignedConversations")
  messages                   Message[]                   @relation("UserMessages")
  agentStatus                AgentStatus?
  supportAgent               SupportAgent?
  supportMessages            SupportMessage[]
  supportRequests            SupportRequest[]
  assignedSupportChats       SupportRequest[]            @relation("AssignedSupportChat")
  testerRelations            TesterRelation[]
  activities                 UserActivity[]
  userDetail                 UserDetail?
  logs                       UserLogs[]
  userPlans                  UserPlan[]
  promoUsages                UserPromoUsage[]
  transactions               UserTransaction[]
  wallet                     UserWallet?
  billingInfo                BillingInfo?
  websiteFeedbackSuggestions WebsiteFeedbackSuggestion[]
  withdrawalRequests         WithdrawalRequest[]
  testingDashboardAndHubApps DashboardAndHub[]           @relation("DashboardAndHubTesters")
  payments                   Payment[]
  invoices                   Invoice[]
  playStoreDeclarations      PlayStoreDeclaration[]
  immediateAttentionItems    ImmediateAttention[]
  handshakeSubscriptions     HandshakeSubscription[]
  handshakeLevel             Int                         @default(1)
   handshakeCompletedCount    Int                         @default(0)
   assignedMails              AdminMail[]                 @relation("AssignedMailUser")
   mailUser                   AdminMail[]                 @relation("MailUser")

   @@map("user")
}

model UserDetail {
  id                        Int                          @id @default(autoincrement())
  userId                    String                       @unique
  first_name                String
  last_name                 String
  phone                     String?                      @unique
  auth_type                 UserAuthType
  roleId                    Int
  banned                    Boolean?                     @default(false)
  ban_reason                String?
  country                   String?
  profile_type              UserProfileType?
  job_role                  UserJobRole?
  company_name              String?
  company_size              UserCompanySize?
  position_in_company       UserCompanyPosition?
  company_website           String?
  experience_level          UserExperienceLevel?
  total_published_apps      UserTotalPublishedApps?
  platform_development      UserDevelopmentPlatform?
  publish_frequency         UserPublishFrequency?
  service_usage             UserTestingServiceReason?
  communication_methods     UserCommunicationMethod[]    @default([])
  notification_preference   UserNotificationPreference[] @default([])
  device_company            String?
  device_model              String?
  ram                       String?
  os                        String?
  screen_resolution         String?
  language                  String?
  network                   String?
  bio                       String?
  years_of_experience       String?
  testing_types             String[]                     @default([])
  tester_devices            String[]                     @default([])
  tester_os_versions        String[]                     @default([])
  areas_of_expertise        String[]                     @default([])
  initial                   Boolean                      @default(true)
  application_status        String?
  discovery_source          String?
  discovery_source_answered Boolean                      @default(false)
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
  availability              TesterAvailability?          @default(AVAILABLE)
  role                      Role                         @relation("UserRole", fields: [roleId], references: [id])
  user                      User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_detail")
}

model TesterRelation {
  id                 Int                       @id @default(autoincrement())
  testerId           String
  dashboardAndHubId  Int?
  offeredAppId       Int?
  isActive           Boolean                   @default(true)
  status             TesterStatus              @default(IN_PROGRESS)
  joinedAt           DateTime                  @default(now())
  completedAt        DateTime?
  daysCompleted      Int                       @default(0)
  lastActivityAt     DateTime?
  statusDetails      Json?
  assignmentSource   TesterAssignmentSource    @default(SELF_JOIN)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  dailyVerifications DailyTesterVerification[]
  dashboardAndHub    DashboardAndHub?          @relation(fields: [dashboardAndHubId], references: [id], onDelete: Cascade)
  offeredApp         DashboardAndHub?          @relation("OfferedAppRelation", fields: [offeredAppId], references: [id])
  tester             User                      @relation(fields: [testerId], references: [id])
  handshakeLinkAsA   HandshakeLink?            @relation("HandshakeRelationA")
  handshakeLinkAsB   HandshakeLink?            @relation("HandshakeRelationB")

  @@unique([testerId, dashboardAndHubId])
  @@map("tester_relation")
}

model HandshakeLink {
  id                Int                @id @default(autoincrement())
  relationAId       Int                @unique
  relationBId        Int                @unique
  relationA         TesterRelation     @relation("HandshakeRelationA", fields: [relationAId], references: [id], onDelete: Cascade)
  relationB         TesterRelation     @relation("HandshakeRelationB", fields: [relationBId], references: [id], onDelete: Cascade)
  aBlockedUntil     DateTime?
  bBlockedUntil     DateTime?
  lastProcessedDay  Int                @default(0)
  status            HandshakeLinkStatus @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("handshake_link")
}

model HandshakeSubscription {
  id                     Int                       @id @default(autoincrement())
  userId                 String
  razorpaySubscriptionId String                    @unique
  razorpayPlanId         String
  status                 HandshakeSubscriptionStatus @default(CREATED)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  paidCount              Int                       @default(0)
  totalCycles            Int
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  user                   User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments               Payment[]

  @@map("handshake_subscription")
}

model DailyTesterVerification {
  id               Int                @id @default(autoincrement())
  testerRelationId Int
  dayNumber        Int
  proofImageUrl    String
  status           VerificationStatus @default(PENDING)
  verifiedAt       DateTime?
  rejectionReason  String?
  metaData         Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  testerRelation   TesterRelation     @relation(fields: [testerRelationId], references: [id], onDelete: Cascade)

  @@unique([testerRelationId, dayNumber])
  @@map("daily_tester_verification")
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Plans {
  id          String     @id @default(uuid()) @map("_id")
  name        String
  price       Float
  package     Int
  features    Json
  billingType String     @default("ONE_TIME")
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  orders      Order[]
  userPlans   UserPlan[]

  @@map("plans")
}

model UserPlan {
  id        Int      @id @default(autoincrement())
  userId    String
  planId    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  plan      Plans    @relation(fields: [planId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_plan")
}

model Blog {
  id               Int          @id @default(autoincrement())
  title            String
  slug             String       @unique
  excerpt          String
  content          String
  authorName       String
  authorAvatarUrl  String?
  authorDataAiHint String?
  imageUrl         String
  dataAiHint       String?
  tags             String[]
  category         BlogCategory @default(GENERAL)
  isActive         Boolean      @default(true)
  viewCount        Int          @default(0)
  date             DateTime     @default(now())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  media            Media[]

  @@map("blog")
}

model Author {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  avatarUrl  String?
  bio        String?
  dataAiHint String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("author")
}

model Faq {
  id          Int         @id @default(autoincrement())
  title       String
  description String
  category    FaqCategory
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("faq")
}

model AppCategory {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  androidApps AndroidApp[]

  @@map("app_category")
}

model DashboardAndHub {
  id                       Int                    @id @default(autoincrement())
  appId                    Int                    @unique
  appOwnerId               String
  appType                  DashboardAndHubAppType
  currentTester            Int
  totalTester              Int
  currentDay               Int
  totalDay                 Int
  instructionsForTester    String?
  rewardPoints             Float?
  costPoints               Float?
  rewardMoney              Float?
  costMoney                Float?
  averageTimeTesting       String?
  minimumAndroidVersion    Float
  status                   DashboardAndHubStatus
  statusDetails            Json?
  promoCodeId              Int?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  testingEndDate           DateTime?
  testingStartDate         DateTime?
  activeTestersOverride    Int?
  bugCountOverride         Int?
  completedTestersOverride Int?
  pendingTestersOverride   Int?
  praiseCountOverride      Int?
  suggestionCountOverride  Int?
  androidApp               AndroidApp             @relation(fields: [appId], references: [id])
  appOwner                 User                   @relation("DashboardAndHubAppOwner", fields: [appOwnerId], references: [id])
  promoCode                PromoCode?             @relation(fields: [promoCodeId], references: [id])
  feedback                 Feedback[]
  testerRelations          TesterRelation[]
  offeredInRelations       TesterRelation[]       @relation("OfferedAppRelation")
  activities               UserActivity[]
  earningHistory           UserTransaction[]
  testers                  User[]                 @relation("DashboardAndHubTesters")
  playStoreDeclaration     PlayStoreDeclaration?

  @@map("dashboard_and_hub")
}

model AndroidApp {
  id                Int              @id @default(autoincrement())
  appName           String           @unique
  appLogoUrl        String           @unique
  appScreenshotUrl1 String
  appScreenshotUrl2 String
  appCategoryId     Int
  packageName       String           @unique
  description       String?
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  appCategory       AppCategory      @relation(fields: [appCategoryId], references: [id])
  dashboardAndHubs  DashboardAndHub?
  media             Media[]
  ratings           Rating[]
  reviews           Review[]
  activities        UserActivity[]

  @@map("android_app")
}

model Media {
  id                         Int                         @id @default(autoincrement())
  type                       MediaType
  mime                       String?
  category                   MediaCategory
  src                        String
  appId                      Int?
  blogId                     Int?
  feedbackId                 Int?                        @unique
  notificationId             Int?
  conversationId             Int?
  messageId                  Int?
  supportRequestId           Int?
  supportMessageId           Int?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  androidApp                 AndroidApp?                 @relation(fields: [appId], references: [id], onDelete: Cascade)
  blog                       Blog?                       @relation(fields: [blogId], references: [id], onDelete: Cascade)
  feedback                   Feedback?                   @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  notification               Notification?               @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  conversation               Conversation?               @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message                    Message?                    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  supportMessage             SupportMessage?             @relation(fields: [supportMessageId], references: [id], onDelete: Cascade)
  supportRequest             SupportRequest?             @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)
  websiteFeedbackSuggestions WebsiteFeedbackSuggestion[] @relation("MediaToWebsiteFeedbackSuggestion")

  @@map("media")
}

model Rating {
  id         Int         @id @default(autoincrement())
  rating     Float
  ratingType RatingType
  appId      Int?
  userId     String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  androidApp AndroidApp? @relation(fields: [appId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])

  @@map("rating")
}

model Feedback {
  id                Int               @id @default(autoincrement())
  message           String
  type              FeedbackType
  priority          FeedbackPriority?
  testerId          String
  dashboardAndHubId Int
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  dashboardAndHub   DashboardAndHub   @relation(fields: [dashboardAndHubId], references: [id], onDelete: Cascade)
  tester            User              @relation(fields: [testerId], references: [id])
  media             Media?
  userActivities    UserActivity[]

  @@map("feedback")
}

model Notification {
  id          Int              @id @default(autoincrement())
  title       String
  description String
  type        NotificationType @default(OTHER)
  url         String?
  userId      String?
  isActive    Boolean
  isAdminOnly Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  media       Media[]
  user        User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification")
}

model UserActivity {
  id                Int              @id @default(autoincrement())
  userId            String
  dashboardAndHubId Int?
  androidAppId      Int?
  actionType        UserActionType
  description       String?
  context           Json?
  ipAddress         String?
  userAgent         String?
  status            AuditResult
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  feedbackId        Int?
  androidApp        AndroidApp?      @relation(fields: [androidAppId], references: [id])
  dashboardAndHub   DashboardAndHub? @relation(fields: [dashboardAndHubId], references: [id])
  feedback          Feedback?        @relation(fields: [feedbackId], references: [id])
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_activity")
}

model UserLogs {
  id          Int          @id @default(autoincrement())
  userId      String
  logType     LogType
  severity    LogSeverity?
  description String
  context     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_logs")
}

model WebsiteFeedbackSuggestion {
  id        Int                    @id @default(autoincrement())
  userId    String
  type      FeedbackSuggestionType
  title     String?
  message   String
  priority  FeedbackPriority?
  status    FeedbackStatus         @default(PENDING)
  reason    String?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  user      User                   @relation(fields: [userId], references: [id])
  media     Media[]                @relation("MediaToWebsiteFeedbackSuggestion")

  @@map("website_feedback_suggestion")
}

/// Unified conversation model: replaces SupportRequest.
/// type separates: AI_CHAT, LIVE_CHAT, TICKET ,  all stored in one table.
model Conversation {
  id       Int                  @id @default(autoincrement())
  type     ConversationType     @default(AI_CHAT)
  status   ConversationStatus   @default(OPEN)
  priority ConversationPriority @default(MEDIUM)
  category ConversationCategory @default(GENERAL)

  subject     String?
  description String?

  userId          String?
  assignedTo      String?
  isEscalated     Boolean   @default(false)
  assignedAt      DateTime?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  lastMessageAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user          User?     @relation("UserConversations", fields: [userId], references: [id])
  assignedAgent User?     @relation("AssignedConversations", fields: [assignedTo], references: [id])
  messages      Message[]
  media         Media[]

  @@index([userId])
  @@index([assignedTo])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("conversation")
}

/// Replaces SupportMessage. Supports system messages for status transitions.
model Message {
  id             Int               @id @default(autoincrement())
  conversationId Int
  senderId       String?
  senderType     MessageSenderType
  messageType    MessageType       @default(TEXT)
  content        String
  metadata       Json?
  isAi           Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser   User?        @relation("UserMessages", fields: [senderId], references: [id])
  media        Media[]

  @@index([conversationId])
  @@index([createdAt])
  @@map("message")
}

/// Persisted agent status (survives reconnections).
model AgentStatus {
  id           Int               @id @default(autoincrement())
  userId       String            @unique
  status       AgentOnlineStatus @default(OFFLINE)
  currentChats Int               @default(0)
  lastSeenAt   DateTime          @default(now())
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agent_status")
}

model ControlRoom {
  id                        Int      @id @default(autoincrement())
  profileSurveyPoints       Int?
  pointsWithdrawalLimit     Int?
  pointsWithdrawalThreshold Int?
  humanChatEnabled          Boolean  @default(true)
  countriesSupported        Int?
  bugsFound                 Int?
  proAppsTested             Int?
  platformUptime            Int?
  uniqueDevices             Int?
  fastTurnaround            Int?
  alexSystemPrompt          String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @default(now()) @updatedAt

  @@map("control_room")
}

// --- Legacy models (kept for data migration, no longer used in new code) ---

model SupportRequest {
  id             Int                @id @default(autoincrement())
  userId         String?
  supportAgentId Int?
  assignedTo     String?
  name           String?
  email          String?
  subject        String
  description    String
  status         SupportStatus      @default(PENDING)
  category       SupportCategory    @default(GENERAL)
  type           SupportRequestType @default(TICKET)
  isEscalated    Boolean            @default(false)
  assignedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  media          Media[]
  messages       SupportMessage[]
  supportAgent   SupportAgent?      @relation(fields: [supportAgentId], references: [id])
  user           User?              @relation(fields: [userId], references: [id])
  assignedUser   User?              @relation("AssignedSupportChat", fields: [assignedTo], references: [id])

  @@map("support_request")
}

model SupportMessage {
  id               Int            @id @default(autoincrement())
  supportRequestId Int
  senderId         String?
  senderType       SenderType
  message          String
  isAi             Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  media            Media[]
  senderUser       User?          @relation(fields: [senderId], references: [id])
  supportRequest   SupportRequest @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)

  @@map("support_message")
}

model SupportAgent {
  id               Int              @id @default(autoincrement())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id])
  assignedRequests SupportRequest[]

  @@map("support_agent")
}

model WithdrawalRequest {
  id          Int              @id @default(autoincrement())
  userId      String
  amount      Float
  currency    String           @default("USD")
  status      WithdrawalStatus @default(PENDING)
  requestedAt DateTime         @default(now())
  processedAt DateTime?
  note        String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id])

  @@map("withdrawal_request")
}

model UserTransaction {
  id                Int                   @id @default(autoincrement())
  userId            String
  userWalletId      Int?
  dashboardAndHubId Int?
  action            EarningAction?
  points            Float?                @default(0)
  package           Float?                @default(0)
  transactionType   UserTransactionType
  status            UserTransactionStatus
  createdAt         DateTime              @default(now())
  paymentMethod     PaymentMethod?
  razorpayPaymentId String?
  dashboardAndHub   DashboardAndHub?      @relation(fields: [dashboardAndHubId], references: [id])
  user              User                  @relation(fields: [userId], references: [id])
  userWallet        UserWallet?           @relation(fields: [userWalletId], references: [id])

  @@index([razorpayPaymentId])
  @@map("user_transactions")
}

model UserWallet {
  id             Int               @id @default(autoincrement())
  userId         String            @unique
  totalPoints    Float             @default(0)
  totalPackages  Float             @default(0)
  balanceMoney   Float             @default(0)
  lastUpdated    DateTime          @updatedAt
  createdAt      DateTime          @default(now())
  earningHistory UserTransaction[]
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_wallet")
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  isAdmin     Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[]
  usersDetail UserDetail[] @relation("UserRole")

  @@map("role")
}

model Module {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[]

  @@map("module")
}

model Permission {
  id            Int      @id @default(autoincrement())
  roleId        Int
  moduleId      Int
  canReadList   Boolean  @default(false)
  canReadSingle Boolean  @default(false)
  canCreate     Boolean  @default(false)
  canUpdate     Boolean  @default(false)
  canDelete     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  module        Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  role          Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, moduleId])
  @@map("permission")
}

model AuditLog {
  id        Int         @id @default(autoincrement())
  actorId   String
  actorRole String
  module    String
  action    String
  targetId  String
  result    AuditResult
  reason    String?
  ip        String
  ua        String
  ts        DateTime    @default(now())
  actor     User        @relation(fields: [actorId], references: [id])

  @@map("audit_log")
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model PasswordReset {
  id                   Int      @id @default(autoincrement())
  password_reset_token String   @unique
  userId               String
  expireAt             DateTime
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset")
}

model Order {
  id              Int         @id @default(autoincrement())
  userId          String
  planId          String?
  packageCount    Int?        @default(1)
  razorpayOrderId String      @unique
  receipt         String      @unique
  amount          Int
  currency        String      @default("INR")
  status          OrderStatus @default(CREATED)
  invoiceId       String?     @unique
  notes           Json?
  attempts        Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  expiresAt       DateTime?
  plan            Plans?      @relation(fields: [planId], references: [id])
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments        Payment[]

  @@index([userId])
  @@index([razorpayOrderId])
  @@index([status])
  @@map("order")
}

model Payment {
  id                     Int                     @id @default(autoincrement())
  orderId                Int?
  razorpayPaymentId      String                  @unique
  razorpayOrderId        String
  razorpaySignature      String?
  amount                 Int
  currency               String                  @default("INR")
  status                 PaymentStatus           @default(PENDING)
  method                 String?
  bank                   String?
  wallet                 String?
  vpa                    String?
  email                  String?
  contact                String?
  fee                    Int?                    @default(0)
  tax                    Int?                    @default(0)
  errorCode              String?
  errorDescription       String?
  errorReason            String?
  amountRefunded         Int                     @default(0)
  refundStatus           RefundStatus?
  notes                  Json?
  captured               Boolean                 @default(false)
  international          Boolean                 @default(false)
  webhookVerified        Boolean                 @default(false)
  webhookPayload         Json?
  paymentType            String                  @default("ONE_TIME")
  handshakeSubscriptionId Int?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  userId                 String?
  customer_name          String?
  customer_email         String?
  amount_inr             Int?
  user                   User?                   @relation(fields: [userId], references: [id])
  order                  Order?                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  handshakeSubscription  HandshakeSubscription?  @relation(fields: [handshakeSubscriptionId], references: [id])
  refunds                Refund[]
  invoice                Invoice?

  @@index([orderId])
  @@index([razorpayPaymentId])
  @@index([razorpayOrderId])
  @@index([status])
  @@index([userId])
  @@index([handshakeSubscriptionId])
  @@map("payment")
}

model Pricing {
  id              Int      @id @default(autoincrement())
  country_code    String   @unique
  country_name    String
  currency_code   String
  currency_symbol String
  amount          Int
  is_active       Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  @@map("pricing")
}

model Invoice {
  id              Int       @id @default(autoincrement())
  paymentId       Int       @unique
  userId          String
  invoice_number  String    @unique
  invoice_type    String    @default("IND")
  service_name    String
  sac_code        String    @default("998313")
  period          String?
  quantity        Int       @default(1)
  unit_price      Int?
  tax_rate        Float     @default(0)
  cgst_amount     Int       @default(0)
  sgst_amount     Int       @default(0)
  igst_amount     Int       @default(0)
  state_code      String?
  due_date        DateTime?
  place_of_supply String?
  supply_type     String?
  amount_in_words String?
  lut_number      String?
  createdAt       DateTime  @default(now())
  payment         Payment   @relation(fields: [paymentId], references: [id])
  user            User      @relation(fields: [userId], references: [id])

  @@map("invoice")
}

model Refund {
  id                Int               @id @default(autoincrement())
  paymentId         Int
  razorpayRefundId  String            @unique
  razorpayPaymentId String
  amount            Int
  currency          String            @default("INR")
  status            RefundModelStatus @default(PENDING)
  reason            String?
  notes             Json?
  speed             String?           @default("normal")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  processedAt       DateTime?
  payment           Payment           @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([razorpayRefundId])
  @@map("refund")
}

model WebhookEventLog {
  id              Int       @id @default(autoincrement())
  eventId         String    @unique
  eventType       String
